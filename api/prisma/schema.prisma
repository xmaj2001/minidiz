// schema.prisma
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------- IGREJA & PARÓQUIA --------------------
model Church {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  parishes Parish[]
}

model Parish {
  id        String   @id @default(cuid())
  name      String
  churchId  String
  createdAt DateTime @default(now())

  church        Church         @relation(fields: [churchId], references: [id])
  members       Member[]
  groups        Group[]
  contributions Contribution[]
  funds         Fund[]
  expenses      Expense[]
}

// -------------------- MEMBROS --------------------
model Member {
  id            String   @id @default(cuid())
  name          String
  email         String?  @unique
  phone         String?  @unique
  birth         DateTime
  gender        String?
  isBaptized    Boolean  @default(false)
  isConfirmed   Boolean  @default(false)
  maritalStatus String?
  occupation    String?

  parishId String
  parish   Parish @relation(fields: [parishId], references: [id])

  groups        Group[]            @relation("MemberGroups")
  migrations    MigrationHistory[]
  contributions Contribution[]
  createdAt     DateTime           @default(now())
}

model MigrationHistory {
  id           String   @id @default(cuid())
  memberId     String
  fromParishId String?
  toParishId   String
  date         DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])
}

// -------------------- GRUPOS --------------------
model Group {
  id        String   @id @default(cuid())
  name      String
  parishId  String
  createdAt DateTime @default(now())

  parish   Parish    @relation(fields: [parishId], references: [id])
  members  Member[]  @relation("MemberGroups")
  funds    Fund[]
  expenses Expense[]
}

// -------------------- FINANÇAS --------------------
model Contribution {
  id          String           @id @default(cuid())
  amount      Float            @default(0)
  type        ContributionType
  isProduct   Boolean          @default(false)
  description String?
  memberId    String
  parishId    String
  createdAt   DateTime         @default(now())

  member Member @relation(fields: [memberId], references: [id])
  parish Parish @relation(fields: [parishId], references: [id])
}

enum ContributionType {
  DIZIMO
  OFERTA
  DOACAO
}

model Fund {
  id        String   @id @default(cuid())
  amount    Float    @default(0)
  parishId  String
  groupId   String?
  createdAt DateTime @default(now())

  parish Parish @relation(fields: [parishId], references: [id])
  group  Group? @relation(fields: [groupId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  parishId    String
  groupId     String?
  createdAt   DateTime @default(now())

  parish Parish @relation(fields: [parishId], references: [id])
  group  Group? @relation(fields: [groupId], references: [id])
}

// -------------------- AUTENTICAÇÃO --------------------
model UserAccount {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  role      UserRole @default(USER)
  createdAt DateTime @default(now())

  providers Provider[]
  sessions  Session[]
  logs      Log[]
}

model Provider {
  id            String       @id @default(cuid())
  type          ProviderType
  providerId    String
  userAccountId String

  userAccount UserAccount @relation(fields: [userAccountId], references: [id])
}

model Session {
  id            String   @id @default(cuid())
  refreshToken  String
  deviceInfo    String?
  expiresAt     DateTime
  userAccountId String

  userAccount UserAccount @relation(fields: [userAccountId], references: [id])
}

enum ProviderType {
  EMAIL
  GOOGLE
  FACEBOOK
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

// -------------------- SISTEMA DE LOG --------------------
model Log {
  id            String   @id @default(cuid())
  action        String
  timestamp     DateTime @default(now())
  ip            String?
  userAccountId String

  userAccount UserAccount @relation(fields: [userAccountId], references: [id])
}

// | Entidade                             | Relações                                                                                                     |
// | ------------------------------------ | ------------------------------------------------------------------------------------------------------------ |
// | **Church**                           | Tem várias **parishes (Paróquias)**                                                                          |
// | **Parish**                           | Pertence a uma **Church** e tem vários **Members** e **Groups**                                              |
// | **Group**                            | Pertence a uma **Parish**, tem vários **Members** (muitos pra muitos)                                        |
// | **Member**                           | Pode ser **de uma Paróquia**, pertencer a **vários grupos**, ter **históricos de migração**, contribuir, etc |
// | **Contribution**                     | Cada contribuição está associada a um **member** e a uma **parish**                                          |
// | **MigrationHistory**                 | Guarda de que paróquia o membro saiu e para onde foi                                                         |
// | **UserAccount / Session / Provider** | Sistema de autenticação modular                                                                              |
// | **Fund**                             | Cada grupo ou paróquia pode ter um fundo próprio pra eventos                                                 |
// | **Expense**                          | Saídas de dinheiro (associadas a uma Paróquia ou Grupo)                                                      |
// | **Log**                              | Rastreia ações dos usuários dentro do sistema                                                                |
